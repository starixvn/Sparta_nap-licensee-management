@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@{
    ViewBag.Title = "Manage LRF Function";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.NAP.Licensee.Model.ViewModel.LrfFunction.SearchLrfFunctionViewModel
@{
    var serializer = new JavaScriptSerializer();
    var groupFunctionList = Model.GroupFunctionList.Select(x => new { label = x.Name, value = x.Id }).ToList();
    groupFunctionList.Insert(0, new { label = "All", value = 0 });
}

@section Headline {
<ul class="breadcrumb title">
    <li>Manage LRF Function</li>
    <li class="current">LRF Functions</li>
</ul>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/function/function.css")
}
@section FooterJs{
<script>
    var initialState = {
        groupFunctionList: @Html.Raw(serializer.Serialize(groupFunctionList)),
        selectedGroupFunction: @Html.Raw(serializer.Serialize(groupFunctionList.First()))
    }
</script>

    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/functionList/functionList.js")
}

<div id="app-container"></div>