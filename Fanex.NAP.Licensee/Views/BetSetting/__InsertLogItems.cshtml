@using Fanex.NAP.Licensee.Model.DataDomain
@using Fanex.NAP.Licensee.Service.Extenstion
@model Fanex.NAP.Licensee.Model.DTO.DefaultBetSetting.SettingLogItem
<table class="table table-bordered child-setting">
    <thead>
        <tr>
            <th>
                Sport/Game
            </th>
            <th>
                Max Bet
            </th>
            <th>
                Max Per Match
            </th>
            <th>
                Max Per Ball
            </th>
            <th>
                Max Payout Per Match
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            var kenoGameType = (IDictionary<int, string>)ViewData[StaticSiteValue.KENOGAMETYPE];

        }
        @foreach (var setting in Model.Settings)
        {
            <tr>
                <td>
                    @setting.SportOrGame.Name
                    @if (setting.SportOrGame.Id == StaticSiteValue.KENOSPORT)
                    {
                        @Html.Raw("&nbsp;-&nbsp;")@kenoGameType.GetValueOrDefault(setting.BetType, "Bettype " + setting.BetType)
                    }
                </td>
                <td class="width-20 text-right">
                    @if (setting.MaxBet.HasValue)
                    {
                        @setting.MaxBet.Value
                    }
                </td>
                <td class="width-20 text-right">
                    @if (setting.MaxPerMatch.HasValue)
                    {
                        @setting.MaxPerMatch.Value
                    }
                </td>
                <td class="width-20 text-right">
                    @if (setting.MaxPerBall.HasValue)
                    {
                        @setting.MaxPerBall.Value
                    }
                </td>
                <td class="width-20 text-right">
                    @if (setting.MaxPayoutPerMatch.HasValue)
                    {
                        @setting.MaxPayoutPerMatch.Value
                    }
                </td>
            </tr>
        }
    </tbody>
</table>