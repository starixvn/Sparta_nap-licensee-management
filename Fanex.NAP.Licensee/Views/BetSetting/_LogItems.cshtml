@model IEnumerable<Fanex.NAP.Licensee.Model.DTO.SettingLogItem>
@foreach (var log in Model)
{
    <tr>
        <td class="text-center">
            @log.LogDate.ToString("yyyy-MM-dd H:mm:ss tt")
        </td>
        <td>
            @log.EditedBy
        </td>
        <td>
            @log.ActionName
        </td>
        <td>
            <div class="table-title">
                @log.ActionName</div>
            @switch (log.ActionId)
            {
                case Fanex.NAP.Licensee.Model.DataDomain.LogActionType.Delete:
                    Html.RenderPartial("~/Views/BetSetting/__DeleteLogItems.cshtml", log);
                    break;
                case Fanex.NAP.Licensee.Model.DataDomain.LogActionType.Insert:
                    Html.RenderPartial("~/Views/BetSetting/__InsertLogItems.cshtml", log);

                    break;
                case Fanex.NAP.Licensee.Model.DataDomain.LogActionType.Update:
                    Html.RenderPartial("~/Views/BetSetting/__UpdateLogItems.cshtml", log);
                    break;
            }
        </td>
    </tr>
}