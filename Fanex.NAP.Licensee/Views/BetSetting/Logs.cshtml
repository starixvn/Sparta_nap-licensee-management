@using System.Web.Optimization;
@{
    ViewBag.Title = "Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section HeadCss {
    @Styles.Render("~/bundles/FanexGridCss")
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">View Log</li>
    </ul>
    <div class="pull-left">
        <a class="btn-green" href="default"><i class="list-icon"></i>View List</a>
    </div>
}
<form role="form" class="form-inline col-sm-12 filter-form filter-logs">
<div class="row row-form">
    <div class="form-group">
        <label for="licensee" class="lbl">
            Licensee</label>
        <select id="licensee" class="width-160">
            <option value="">All Licensees</option>
            <option value="3">12Bet</option>
        </select>
    </div>
    <div class="form-group">
        <label for="currency" class="lbl">
            Currency</label>
        <select id="currency" class="width-160">
            <option value="">All currencies</option>
        </select>
    </div>
    <div class="form-group">
        <label for="agent" class="lbl">
            Agent</label>
        <select id="currency" class="width-160">
            <option value="">All</option>
        </select>
    </div>
</div>
<div class="row row-form">
    <div class="form-group">
        <label for="agent" class="lbl">
            To</label>
        <input type="text" id="to-date" value="Aug 26,2014" class="width-160 text-box single-line valid">
    </div>
    <div class="form-group">
        <label for="agent" class="lbl">
            From</label>
        <input type="text" id="from-date" value="Aug 26,2014" class="width-160 text-box single-line valid">
    </div>
    <div class="form-group">
        <input type="submit" value="Generate" class="btn-generate">
    </div>
</div>
</form>
