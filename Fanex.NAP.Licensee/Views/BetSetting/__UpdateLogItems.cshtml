@using Fanex.NAP.Licensee.Model.DataDomain
@using Fanex.NAP.Licensee.Model.DTO.DefaultBetSetting
@using Fanex.NAP.Licensee.Service.Extenstion

@model Fanex.NAP.Licensee.Model.DTO.DefaultBetSetting.SettingLogItem
<table class="table table-bordered child-setting">
    <thead>
        <tr>
            <th rowspan="2">
                Sport/Game
            </th>
            <th colspan="2">
                Min Bet
            </th>
            <th colspan="2">
                Max Bet
            </th>
            <th colspan="2">
                Max Per Ball
            </th>
            <th colspan="2">
                Max Per Match
            </th>
            <th colspan="2">
                Max Payout Per Match
            </th>
        </tr>
        <tr>
            <th>
                Old
            </th>
            <th>
                New
            </th>
            <th>
                Old
            </th>
            <th>
                New
            </th>
            <th>
                Old
            </th>
            <th>
                New
            </th>
            <th>
                Old
            </th>
            <th>
                New
            </th>
            <th>
                Old
            </th>
            <th>
                New
            </th>
        </tr>
    </thead>
    <tbody>
        @{

            var updatedSportList = Model.OldSettings.Select(i => new { SportId = i.SportOrGame.Id, Bettype = i.BetType })
                .Union(Model.Settings.Select(i => new { SportId = i.SportOrGame.Id, Bettype = i.BetType }));
            var kenoGameType = (IDictionary<int, string>)ViewData[StaticSiteValue.KENOGAMETYPE];
        }
        @foreach (var item in updatedSportList)
        {
            BetSettingBySport oldValue = Model.OldSettings.SingleOrDefault(i => i.SportOrGame.Id == item.SportId && i.BetType == item.Bettype);
            BetSettingBySport newValue = Model.Settings.SingleOrDefault(i => i.SportOrGame.Id == item.SportId && i.BetType == item.Bettype);

            <tr>
                <td>
                    @if (oldValue != null)
                    {
                        @oldValue.SportOrGame.Name
                    }
                    else if (newValue != null)
                    {
                        @newValue.SportOrGame.Name
                    }
                    @if (oldValue != null && oldValue.SportOrGame.Id == StaticSiteValue.KENOSPORT)
                    {
                        @Html.Raw("&nbsp;-&nbsp;")@kenoGameType.GetValueOrDefault(oldValue.BetType, "Bettype " + oldValue.BetType);
                    }
                    else if (newValue != null && newValue.SportOrGame.Id == StaticSiteValue.KENOSPORT)
                    {
                        @Html.Raw("&nbsp;-&nbsp;")@kenoGameType.GetValueOrDefault(newValue.BetType, "Bettype " + newValue.BetType);
                    }
                </td>
                <td class="width-10 text-right">
                    @if (oldValue != null && oldValue.MinBet.HasValue)
                    {

                        @oldValue.MinBet.Value

                    }
                </td>
                <td class="width-10 lbl-new text-right">
                    @if (newValue != null && newValue.MinBet.HasValue)
                    {
                        @newValue.MinBet.Value
                    }
                </td>
                <td class="width-10 text-right">
                    @if (oldValue != null && oldValue.MaxBet.HasValue)
                    {

                        @oldValue.MaxBet.Value

                    }
                </td>
                <td class="width-10 lbl-new text-right">
                    @if (newValue != null && newValue.MaxBet.HasValue)
                    {
                        @newValue.MaxBet.Value
                    }
                </td>
                <td class="width-10 text-right">
                    @if (oldValue != null && oldValue.MaxPerBall.HasValue)
                    {

                        @oldValue.MaxPerBall.Value

                    }
                </td>
                <td class="width-10 text-right lbl-new">
                    @if (newValue != null && newValue.MaxPerBall.HasValue)
                    {
                        @newValue.MaxPerBall.Value
                    }
                </td>
                <td class="width-10 text-right">
                    @if (oldValue != null && oldValue.MaxPerMatch.HasValue)
                    {

                        @oldValue.MaxPerMatch.Value

                    }
                </td>
                <td class="width-10 text-right lbl-new">
                    @if (newValue != null && newValue.MaxPerMatch.HasValue)
                    {
                        @newValue.MaxPerMatch.Value
                    }
                </td>
                <td class="width-10 text-right">
                    @if (oldValue != null && oldValue.MaxPayoutPerMatch.HasValue)
                    {

                        @oldValue.MaxPayoutPerMatch.Value

                    }
                </td>
                <td class="width-10 text-right lbl-new">
                    @if (newValue != null && newValue.MaxPayoutPerMatch.HasValue)
                    {
                        @newValue.MaxPayoutPerMatch.Value
                    }
                </td>
            </tr>
        }
    </tbody>
</table>