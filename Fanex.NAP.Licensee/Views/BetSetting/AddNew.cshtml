@{
    ViewBag.Title = "AddNew";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.NAP.Licensee.Model.ViewModel.SingleDefaultBetSettingViewModel
@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">Add Default Bet Setting</li>
    </ul>
    <div class="pull-left">
        <a class="btn-back" href="default">← Back To List</a>
    </div>
}
<form role="form" action="#" class="form-inline col-sm-12 filter-form form-add-setting">
<div class="form-group">
    <label for="licensee">
        Site</label>
    <select id="licensee" class="width-160">
    </select>
</div>
<div class="form-group">
    <label for="currency">
        Currency</label>
    <select id="currency" class="width-160">
    </select>
</div>
<div class="form-group">
    <label for="agent">
        Agent</label>
    <select id="agent" class="width-160">
    </select>
</div>
<div class="form-group">
    <input type="button" id="loadtemplate" value="Load template" class="btn-primary" />
</div>
</form>
@if (Model.IsValid)
{
    <div class="col-sm-12">
        @if (Model.Sportbook.Count > 0)
        {
            <div class="row group">
                <div class="col-sm-12 title-group" id="sb-area">
                    <i class="icon-collapse" data-key="area-icon"></i>Sportbook</div>
                <div class="col-sm-12 content" data-key="area-content">
                    <label class="checkbox-inline">
                        <input type="checkbox" id="copy-sb" data-key="#sb-table">
                        Copy all Bet Setting from 1st row
                    </label>
                    <table class="table table-bordered table-setting" id="sb-table">
                        <thead>
                            <tr>
                                <th class="col20">
                                    Sport Type
                                </th>
                                <th class="col40">
                                    Max Bet
                                </th>
                                <th class="col40">
                                    Max Per Match
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sb in Model.Sportbook)
                            {
                                <tr>
                                    <td>
                                        @sb.SportOrGame.Name
                                    </td>
                                    <td>
                                        <input data-key="MaxBet" type="text" value="@(sb.MaxBet.HasValue ? sb.MaxBet.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                    <td>
                                        <input data-key="MaxPerMatch" type="text" value="@(sb.MaxPerMatch.HasValue ? sb.MaxPerMatch.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (Model.NumberGame.Count > 0)
        {
            <div class="row group">
                <div class="col-sm-12 title-group" id="ng-area">
                    <i class="icon-collapse" data-key="area-icon"></i>Number Game</div>
                <div class="col-sm-12 content" data-key="area-content">
                    <table class="table table-bordered table-setting">
                        <thead>
                            <tr>
                                <th class="col20">
                                </th>
                                <th class="col20">
                                    Max Bet
                                </th>
                                <th class="col30">
                                    Max Per Match
                                </th>
                                <th class="col30">
                                    Max Per Ball
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ng in Model.NumberGame)
                            {
                                <tr>
                                    <td>
                                        @ng.SportOrGame.Name
                                    </td>
                                    <td>
                                        <input data-key="MaxBet" type="text" value="@(ng.MaxBet.HasValue ? ng.MaxBet.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                    <td>
                                        <input data-key="MaxPerMatch" type="text" value="@(ng.MaxPerMatch.HasValue ? ng.MaxPerMatch.Value.ToString() : string.Empty)" class="width-170 txt-max" />
                                    </td>
                                    <td>
                                        <input data-key="MaxPerBall" type="text" value="@(ng.MaxPerMatch.HasValue ? ng.MaxPerMatch.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (Model.VirtualSport.Count > 0)
        {
            <div class="row group">
                <div class="col-sm-12 title-group" id="vs-area">
                    <i class="icon-collapse" data-key="area-icon"></i>Virtual Sports</div>
                <div class="col-sm-12 content" data-key="area-content">
                    <label class="checkbox-inline">
                        <input type="checkbox" id="copy-vs" data-key="#vs-table">
                        Copy all Bet Setting from 1st row
                    </label>
                    <table class="table table-bordered table-setting" id="vs-table">
                        <thead>
                            <tr>
                                <th class="col20">
                                    Sport Type
                                </th>
                                <th class="col40">
                                    Max Bet
                                </th>
                                <th class="col40">
                                    Max Per Match
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vs in Model.VirtualSport)
                            {
                                <tr>
                                    <td>
                                        @vs.SportOrGame.Name
                                    </td>
                                    <td>
                                        <input data-key="MaxBet" type="text" value="@(vs.MaxBet.HasValue ? vs.MaxBet.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                    <td>
                                        <input data-key="MaxPerMatch" type="text" value="@(vs.MaxPerMatch.HasValue ? vs.MaxPerMatch.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (Model.Keno.Count > 0)
        {
            <div class="row group">
                <div class="col-sm-12 title-group" id="kn-area">
                    <i class="icon-collapse" data-key="area-icon"></i>Keno</div>
                <div class="col-sm-12 content" data-key="area-content">
                    <label class="checkbox-inline">
                        <input type="checkbox" id="copy-kn" data-key="#kn-table">
                        Copy all Bet Setting from 1st row
                    </label>
                    <table class="table table-bordered table-setting" id="kn-table">
                        <thead>
                            <tr>
                                <th class="col20">
                                    Game Type
                                </th>
                                <th class="col40">
                                    Max Bet
                                </th>
                                <th class="col40">
                                    Max Per Match
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kn in Model.Keno)
                            {
                                <tr>
                                    <td>
                                        @kn.SportOrGame.Name
                                    </td>
                                    <td>
                                        <input data-key="MaxBet" type="text" value="@(kn.MaxBet.HasValue ? kn.MaxBet.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                    <td>
                                        <input data-key="MaxPerMatch" type="text" value="@(kn.MaxPerMatch.HasValue ? kn.MaxPerMatch.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    <div class="col-sm-12">
        <button class="btn-primary">
            Submit</button>
        <button onclick="javascript:history.go(-1);return false;" class="btn-back">
            Back to List</button>
    </div>
}

@section FooterJs
{
    <script type="text/javascript">
        $(document).ready(function () {
            addNew.setup();
        });
    </script>
}