@{
    ViewBag.Title = "AddNew";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">Add Default Bet Setting</li>
    </ul>
    <div class="pull-left">
        <a class="btn-back" href="default">← Back To List</a>
    </div>
}

<form role="form" class="form-inline col-sm-12 filter-form form-add-setting" >
    <div class="form-group">
        <label for="site" class="lbl">
            Site</label>
        <select id="site" class="width-160">
            <option value="">12Bet</option>
        </select>
    </div>
    <div class="form-group">
        <label for="currency" class="lbl">
            Currency</label>
        <select id="Agent" class="width-160">
            <option value="">All Currency</option>
        </select>
         
    </div>
    <div class="form-group">
        <label for="agent" class="lbl">
            Agent</label>
      <select id="Agent" class="width-160">
            <option value="">All Agent</option>
        </select>
    </div>
</form>
