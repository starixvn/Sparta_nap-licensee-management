@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@model Fanex.NAP.Licensee.Model.ViewModel.LicenseeSetting.NewLicenseeViewModel
@{
    ViewBag.Title = "Set Up New Licensee";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";

    var serializer = new JavaScriptSerializer();
    var productList = Model.ProductList.Select(x => new { label = x.ProductName, value = x.ProductCode }).ToList();
    var resellerList = Model.ResellerList.Select(x => new { label = x, value = x }).ToList();
    var systemList = Model.SystemList.Select(x => new { label = x.Description, value = x.SystemName }).ToList();
    var selectedSystem = Model.SelectedSystem.Select(x => new { label = x.Description, value = x.SystemName }).ToList();
}

@section Headline {
    <ul class="breadcrumb title">
        <li>Licensee Setting</li>
        <li class="current">Set Up New Licensee</li>
    </ul>

    <a class="btn-back" href="@Url.Content("~/LicenseeSetting/Index")">← Back To List</a>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/licensee/licensee.css")
}
@section FooterJs{
    <script>
        var initialState = {
            productList: @Html.Raw(serializer.Serialize(productList)),
            resellerList: @Html.Raw(serializer.Serialize(resellerList)),
            systemList: @Html.Raw(serializer.Serialize(systemList)),
            selectedSystem: @Html.Raw(serializer.Serialize(selectedSystem)),
        }
    </script>

    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/addlicensee/addlicensee.js")
}

<div id="app-container"></div>