@using Fanex.NAP.Licensee.Web

@model Fanex.NAP.Licensee.Model.DTO.Vendor
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";
}

@section Headline {
    <ul class="breadcrumb title">
        <li>Vendor Info</li>
        <li><a href="~/Vendor">Licensee Site</a></li>
        <li class="current">Edit</li>
    </ul>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/reactpages/dist/css/editvendor/editvendor.css")
}

@section FooterJs{
    <script>
        var initialState = {
            vendorInfo: {
                SiteName: '@Model.SiteName',
                InternalUrl: '@Model.InternalUrl',
                LrfUrl: '@Model.LrfUrl',
                AffiliateUrl: '@Model.AffiliateUrl',
                IgnoredFunctions: '@Html.Raw(Model.Exclusions)'
            }
        }
    </script>
    @BundleManager.IncludeScriptsByEnv("~/reactpages/dist/js/editvendor/editvendor.js")
}

<div id="app-container"></div>
