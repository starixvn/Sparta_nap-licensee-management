@using Fanex.NAP.Licensee.Web

@model Fanex.NAP.Licensee.Model.ViewModel.LicenseeVendor.EditVendorViewModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";

    var vendor = Model.VendorInfo;
}

@section Headline {
    <ul class="breadcrumb title">
        <li>Vendor Info</li>
        <li>Licensee Site</li>
        <li class="current">Edit</li>
    </ul>

    <a class="btn-back" href="~/Vendor">← Back To List</a>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/reactpages/dist/css/editvendor/editvendor.css")
}

@section FooterJs{
    <script>
        var initialState = {
            vendorInfo: {
                VendorId: '@vendor.VendorId',
                SiteName: '@vendor.SiteName',
                InternalUrl: '@vendor.InternalUrl',
                LrfUrl: '@vendor.LrfUrl',
                AffiliateUrl: '@vendor.AffiliateUrl',
                IgnoredFunctions: '@Html.Raw(vendor.Exclusions)'
            },
            originalExclusionList: '@Html.Raw(vendor.Exclusions)',
            functionKeyList: @Html.Raw(Model.FunctionKeyList)
        }
    </script>
    @BundleManager.IncludeScriptsByEnv("~/reactpages/dist/js/editvendor/editvendor.js")
}

<div id="app-container"></div>
