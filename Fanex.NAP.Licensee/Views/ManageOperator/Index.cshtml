@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.NAP.Licensee.Model.ViewModel.ManageOperator.ManageOperatorViewModel
@{
    var serializer = new JavaScriptSerializer();

    var currencyList = Model.CurrencyList.Select(x => new { label = x.Name, value = x.Id }).ToList();
    currencyList.Insert(0, new { label = "All", value = 0 });
    var siteNameList = Model.SiteNameList.Select(x => new { label = x, value = x }).ToList();
    siteNameList.Insert(0, new { label = "All", value = string.Empty });
}

@section Headline {
<ul class="breadcrumb title">
    <li>Manage Operator</li>
    <li class="current">Operators</li>
</ul>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/operator/operator.css")
}
@section FooterJs{
    <script>
        var initialState = {
            currencyList: @Html.Raw(serializer.Serialize(currencyList)),
            selectedCurrency: @Html.Raw(serializer.Serialize(currencyList.First())),
            siteNameList: @Html.Raw(serializer.Serialize(siteNameList)),
            selectedSiteName: @Html.Raw(serializer.Serialize(siteNameList.First())),
        }
    </script>

    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/operator/operator.js")
}

<div id="app-container"></div>

