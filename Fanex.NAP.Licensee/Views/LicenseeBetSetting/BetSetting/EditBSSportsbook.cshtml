<div ng-controller="editBSSportsbookCtrl" class="filter-form">
    <form class="{{isExceedingThreshold ? 'disable-all-elem' : ''}}" name="myForm">
        <h5>Edit Bet Setting Sportsbook <span class="text-highlight">({{header}})</span></h5>
        <label ng-if="!option" class="checkbox-inline">
            <input ng-change="applyForMembers()" ng-model="editBS.IsApplyForMembersChecked" type="checkbox">
            Apply for players
        </label>
        <div ng-style="!option && {'margin-left': '20px'}">
            <input ng-model="editBS.applyForMember" ng-disabled="editBS.applyForMember===-1" type="radio" id="allPlayers" name="players" ng-value="1" />
            <label style="font-weight: normal;" for="allPlayers">All players (Existing and New players)</label><br>
            <input ng-if="!option" ng-model="editBS.applyForMember" ng-disabled="editBS.applyForMember===-1" type="radio" id="newPlayers" name="players" ng-value="2" />
            <label ng-if="!option" style="font-weight: normal;" for="newPlayers">New players only</label>
            <input ng-if="option" ng-model="editBS.applyForMember" ng-disabled="editBS.applyForMember===-1" type="radio" id="existingPlayers" name="players" ng-value="3" />
            <label ng-if="option" style="font-weight: normal;" for="existingPlayers">Existing players only</label>
        </div>
        <table id="table__bet-setting" class="table table-bordered table-setting">
            <thead>
                <tr>
                    <th>
                        <div>
                            <input type="checkbox" ng-model="isAllSportChecked" ng-change="checkAllSports()" />
                            All sports
                            <span class="icon-copy-setting {{buttonStatus.isCopyDisabled ? 'disable-elem' : ''}}" ng-click="copyAllFromOne()" title="Copy Bet Setting from 1st selected row" id="copy_setting_icon">
                            </span>
                        </div>
                    </th>
                    <th>
                        Min Bet
                    </th>
                    <th>
                        Max Bet
                    </th>
                    <th>
                        Max Per Match
                    </th>
                    <th>
                        Max Payout Per Match
                    </th>
                </tr>
            </thead>
            <tbody>
                @*Currency Bet Setting*@
                <tr ng-if="option===0" ng-repeat="item in editBS.BSRows">
                    <td class="action">
                        <label style="font-weight: normal; display: inline;">
                            <input type="checkbox" ng-model="item.IsRowSelected" />
                            {{item.SportTypeName}}
                        </label>
                    </td>
                    <td class="minbet">
                        <input class="minbet" ng-trim="false" old-value="orgData.BSs[$index].MinBet" name="MinBet" type="text" ng-attr-uplinemin="*" ng-attr-uplinemax="*" ng-attr-min="0" ng-attr-max="{{item.MaxBet | number}}" bs-validation ng-model="item.MinBet" ng-disabled="!item.IsRowSelected" />
                        <input ng-if="agentId!==0" class="minbet value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMinBet" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMinBet" ng-disabled="true" />
                    </td>
                    <td class="not-compare">
                        <input ng-trim="false" old-value="orgData.BSs[$index].MaxBet" name="MaxBet" type="text" ng-attr-uplinemin="*" ng-attr-uplinemax="*" ng-attr-min="{{item.MinBet | number}}" ng-attr-max="{{item.MaxPerMatch | number}}" bs-validation ng-model="item.MaxBet" ng-disabled="!item.IsRowSelected" />
                        <input ng-if="agentId!==0" class="value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMaxBet" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMaxBet" ng-disabled="true" />
                    </td>
                    <td class="not-compare">
                        <input ng-trim="false" old-value="orgData.BSs[$index].MaxPerMatch" name="MaxPerMatch" ng-attr-uplinemin="*" ng-attr-uplinemax="*" type="text" ng-attr-min="{{item.MaxBet | number}}" ng-attr-max="{{item.MaxPayoutPerMatch | number}}" bs-validation ng-model="item.MaxPerMatch" ng-disabled="!item.IsRowSelected" />
                        <input ng-if="agentId!==0" class="value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMaxPerMatch" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMaxPerMatch" ng-disabled="true" />
                    </td>
                    <td class="not-compare">
                        <input ng-trim="false" old-value="orgData.BSs[$index].MaxPayoutPerMatch" name="MaxPayoutPerMatch" ng-attr-uplinemin="*" ng-attr-uplinemax="*" type="text" ng-attr-min="{{item.MaxPerMatch | number}}" ng-attr-max="*" bs-validation ng-model="item.MaxPayoutPerMatch" ng-disabled="!item.IsRowSelected" />
                        <input ng-if="agentId!==0" class="value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMaxPayoutPerMatch" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMaxPayoutPerMatch" ng-disabled="true" />
                    </td>
                </tr>

                @*Player Bet Setting*@
                <tr ng-if="option===1" ng-repeat="item in editBS.BSRows">
                    <td class="action">
                        <label style="font-weight: normal; display: inline;">
                            <input type="checkbox" ng-model="item.IsRowSelected" />
                            {{item.SportTypeName}}
                        </label>
                    </td>
                    <td class="minbet">
                        <input class="minbet" ng-trim="false" old-value="orgData.BSs[$index].MinBet" name="MinBet" type="text" ng-attr-uplinemin="{{item.UplineMinBet}}" ng-attr-uplinemax="*" ng-attr-min="0" ng-attr-max="{{item.MaxBet | number}}" bs-validation ng-model="item.MinBet" ng-disabled="!item.IsRowSelected" />
                        <span class="content-center">&gt;&equals;</span>
                        <input class="minbet value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMinBet" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMinBet" ng-disabled="true" />
                    </td>

                    <td>
                        <input ng-trim="false" old-value="orgData.BSs[$index].MaxBet" name="MaxBet" type="text" ng-attr-uplinemin="*" ng-attr-uplinemax="{{item.UplineMaxBet}}" ng-attr-min="{{item.MinBet | number}}" ng-attr-max="{{item.MaxPerMatch | number}}" bs-validation ng-model="item.MaxBet" ng-disabled="!item.IsRowSelected" />
                        <span class="content-center">&lt;&equals;</span>
                        <input class="value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMaxBet" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMaxBet" ng-disabled="true" />
                    </td>
                    <td>
                        <input ng-trim="false" old-value="orgData.BSs[$index].MaxPerMatch" name="MaxPerMatch" ng-attr-uplinemin="*" ng-attr-uplinemax="{{item.UplineMaxPerMatch}}" type="text" ng-attr-min="{{item.MaxBet | number}}" ng-attr-max="{{item.MaxPayoutPerMatch | number}}" bs-validation ng-model="item.MaxPerMatch" ng-disabled="!item.IsRowSelected" />
                        <span class="content-center">&lt;&equals;</span>
                        <input class="value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMaxPerMatch" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMaxPerMatch" ng-disabled="true" />
                    </td>
                    <td>
                        <input ng-trim="false" old-value="orgData.BSs[$index].MaxPayoutPerMatch" name="MaxPayoutPerMatch" ng-attr-uplinemin="*" ng-attr-uplinemax="{{item.UplineMaxPayoutPerMatch}}" type="text" ng-attr-min="{{item.MaxPerMatch | number}}" ng-attr-max="*" bs-validation ng-model="item.MaxPayoutPerMatch" ng-disabled="!item.IsRowSelected" />
                        <span class="content-center">&lt;&equals;</span>
                        <input class="value" ng-attr-uplinemin="*" ng-attr-uplinemax="*" name="UplineMaxPayoutPerMatch" type="text" ng-attr-min="0" ng-attr-max="*" bs-validation ng-model="item.UplineMaxPayoutPerMatch" ng-disabled="true" />
                    </td>
                </tr>
                <tr ng-if="!isExceedingThreshold">
                    <td class="action">
                        <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                               ng-disabled="!buttonStatus.isNextEnabled" />
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
</div>