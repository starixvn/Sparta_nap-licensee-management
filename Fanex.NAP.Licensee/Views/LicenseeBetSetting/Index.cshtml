@{
    ViewBag.Title = "Licensee Bet Setting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Licensee Configuration</li>
        <li class="current">Licensee Bet Setting</li>
    </ul>
    <div class="pull-left">
        <a href="logs" class="btn-green"><i class="list-icon"></i>View Log</a>
    </div>
}
@section HeadCss
{
    <link href="@Url.Content("~/Content/build/licenseebetsetting.min.css")" rel='stylesheet' type='text/css' media='all' />
    <link href="@Url.Content("~/Content/build/core.min.css")" rel='stylesheet' type='text/css' media='all' />
}
<div ng-app="licenseeBetSetting" ng-controller="licenseeBetSettingCtrl">
    <div id="loadingMsgBox" class="icon-loading" ng-hide="!isLoading"></div>
    <div class="col-md-12 filter-form">
        <div class="row">
            <div class="form-group col-sm-12 col-xs-12 col-md-3 col-lg-3">
                <label class="col-sm-12 col-xs-12 col-md-2 col-lg-3">
                    Licensee
                </label>
                <dropdowntreesingle class="col-sm-12 col-xs-12 col-md-3 col-lg-6"
                                    data-ng-model="filterData.selectedLicensee"
                                    data-settings="licenseeSettings"
                                    text-settings="TextSettings"
                                    data-ng-change="selectedLicenseeChanged()"
                                    data-ng-style="{ 'padding': 0}">
                </dropdowntreesingle>
            </div>
            <div class="form-group col-sm-12 col-xs-12 col-md-5 col-lg-4">
                <label class="col-sm-12 col-xs-12 col-md-5 col-lg-4">
                    Currency (Super)
                </label>
                <dropdowntreesingle class="col-sm-12 col-xs-12 col-md-6 col-lg-6"
                                    data-ng-model="filterData.selectedSuperLicensee"
                                    data-settings="superLicenseeSettings"
                                    text-settings="TextSettings"
                                    data-ng-change="selectedSuperLicenseeChanged(filterData.selectedSuperLicensee.Id)"
                                    data-ng-style="{ 'padding': 0}">
                </dropdowntreesingle>
            </div>
            <div class="form-group col-sm-12 col-xs-12 col-md-3 col-lg-3">
                <label class="col-sm-12 col-xs-12 col-md-3 col-lg-4">
                    Subsidiary
                </label>
                <dropdowntreesingle class="col-sm-12 col-xs-12 col-md-4 col-lg-6"
                                    data-ng-model="filterData.selectedAgent"
                                    data-settings="agentSettings"
                                    text-settings="TextSettings"
                                    data-ng-style="{ 'padding': 0}">
                </dropdowntreesingle>
            </div>
            <div class="form-group col-md-1 col-lg-2"></div>
        </div>
        <div class="row">
            <div class="form-group col-sm-12 col-xs-12 col-md-3 col-lg-3">
                <label class="col-sm-12 col-xs-12 col-md-2 col-lg-3">
                    Product
                </label>
                <select ng-if="filterData.productTypes.length > 0"
                        ng-init="filterData.selectedProductType = filterData.productTypes[0]"
                        ng-options="item.Name for item in filterData.productTypes track by item.Id"
                        ng-model="filterData.selectedProductType"
                        ng-change="selectedProductTypeChanged()"
                        id="product-type" class="col-sm-12 col-xs-12 col-md-7 col-lg-6">
                </select>
            </div>
            <div class="form-group col-sm-12 col-xs-12 col-md-5 col-lg-4">
                <label class="col-sm-12 col-xs-12 col-md-5 col-lg-4">
                    Option
                </label>
                <select ng-if="filterData.selectedProductType.Functions.length > 0"
                        ng-init="filterData.selectedFunction = filterData.selectedProductType.Functions[0]"
                        ng-options="item for item in filterData.selectedProductType.Functions track by item"
                        ng-model="filterData.selectedFunction"
                        id="product-function" class="col-sm-12 col-xs-12 col-md-6 col-lg-6">
                </select>
            </div>
        </div>
        <div class="form-group col-sm-12 col-xs-12 col-md-3 col-lg-3">
            <input style="text-align: right" type="button" id="Select" value="Select" class="btn btn-primary" ng-click="selectEventHandler()" ng-disabled="!buttonStatus.isButtonEnable"/>
        </div>
    </div>
    <!--Dynamic View-->
    <div ng-view class="fade-in">
    </div>
    <div id="confirm-box" class="confirm-message hidden" ng-bind-html="errMessage"> title="Confirmation"></div>
    @Html.Partial("_Template")
</div>
@section FooterJs
{
    <script src="@Url.Content("~/Scripts/build/licenseebetsetting.min.js")"></script>
}
