@{
    ViewBag.Title = "Bet Setting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">Licensee Setting</li>
    </ul>
}
@section HeadCss
{
    <link href="@Url.Content("~/Content/build/licenseesetting.min.css")" rel='stylesheet' type='text/css' media='all' />
    <link href="@Url.Content("~/Content/build/core.min.css")" rel='stylesheet' type='text/css' media='all' />
}
<div ng-app="settingConfiguration" ng-controller="settingConfigurationCtrl">
    <div class="col-md-12 filter-form">
        <div class="row">
            <div class="form-group col-md-3">
                <div class="row">
                    <label class="col-md-5">
                        Licensee
                    </label>
                    <selectwithsearch name="licensee"
                                      class="col-md-5"
                                      data-ng-model="filterData.selectedLicensee"
                                      data-settings="licenseeSettings"
                                      required-settings="licenseeRequiredSettings"
                                      data-ng-change="selectedLicenseeChanged()"
                                      data-ng-style="{ 'padding': 0}">
                    </selectwithsearch>
                </div>
            </div>
            <div class="form-group col-md-3">
                <div class="row">
                    <label class="col-md-5">
                        Super Username
                    </label>
                    <selectwithsearch 
                                      id="super-username"
                                      name="super-username"
                                      class="col-md-3 width-160"
                                      data-ng-model="filterData.selectedSuperLicensee"
                                      data-settings="superLicenseeSettings"
                                      required-settings="superLicenseeRequiredSettings"
                                      data-ng-change="selectedSuperLicenseeChanged(filterData.selectedSuperLicensee.Id)"
                                      data-ng-style="{ 'padding': 0}">
                    </selectwithsearch>
                </div>
            </div>
            <div class="form-group col-md-3">
                <div class="row">
                    <label class="col-md-5">
                        Select Agent List
                    </label>
                    <selectwithsearch name="agentList"
                                      class="col-md-5"
                                      data-ng-model="filterData.selectedAgent"
                                      data-settings="agentSettings"
                                      required-settings="agentRequiredSettings"
                                      data-ng-disabled="!isEnableAgentListSelectAndAgentOnlyCheckbox"
                                      data-ng-style="{ 'padding': 0}"
                                      >
                    </selectwithsearch>
                </div>
            </div>
            <div class="form-group">
                <label class="checkbox-inline">
                    <input type="checkbox" id="agent-only" ng-disabled="!isEnableAgentListSelectAndAgentOnlyCheckbox" ng-model="isAgentOnly" />
                    Agent only
                </label>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-md-3">
                <div class="row">
                    <label class="col-md-5">
                        Select Product
                    </label>
                    <select ng-options="item.Name for item in filterData.productTypes track by item.Id"
                            ng-model="filterData.selectedProductType" ng-change="selectedProductTypeChanged()"
                            id="product-type" class="col-md-3 width-160">
                    </select>
                </div>
            </div>
            <div class="form-group col-md-3">
                <div class="row">
                    <label class="col-md-5">
                        Select Function
                    </label>
                    <select ng-options="item for item in filterData.selectedProductType.Functions track by item"
                            ng-model="filterData.selectedFunction" ng-init="filterData.selectedFunction = filterData.selectedProductType.Functions[0]"
                            id="product-function" class="col-md-3 width-160"
                            ng-change="selectedFunctionChanged()">
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-md-3">
                <input type="button" id="Select" value="Select" class="btn btn-primary" ng-click="selectEventHandler()" ng-disabled="!buttonStatus.isButtonEnable" />
            </div>
        </div>
    </div>
    <!--Dynamic View-->
    <div ng-view class="fade-in">
    </div>
    <script type="text/ng-template" id="selectwithsearch.template.html">
                <div class="dropdown">
            <button type="button" class="btn" data-ng-click="toggleSelect()" data-ng-disabled="disabled" data-ng-class="{'ng-invalid': !valid()}">
                <span class="pull-left">{{header}}</span> <span class="caret pull-right">
                </span>
            </button>
            <ul data-ng-if="items.length > 0" class="dropdown-menu" data-ng-style="{ 'width': _settings.width}">
                <li data-ng-if="_settings.hasFilter">
                    <div>
                        <input type="text" class="filter" data-ng-model="searchText.value" autofocus="autofocus"
                               placeholder="{{_textSettings.Filter}}">
                    </div>
                </li>

                <li class="divider"></li>
                <li>
                    <div class="tree">
                        <ul>
                            <li data-ng-if="_requiredSettings.Require">
                                <a data-ng-click="checkNA();">
                                    <span class="group-text">Please select ...</span>
                                </a>
                            </li>
                            <li data-ng-repeat="item1 in items | filter:filterSearchText">
                                <a data-ng-class="getItemClass(item1);" data-ng-attr-id="item-{{item1.id}}"
                                   data-ng-click="checkItem(item1);">
                                    <span class="group-text">{{item1.label | itemFormatFilter:item1:0:_settings.itemFormatter}}</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </div>
    </script>

</div>
@section FooterJs
{
    <script src="@Url.Content("~/Scripts/build/angular.min.js")"></script>
    <script src="@Url.Content("~/Scripts/build/licenseesetting.min.js")"></script>
}
