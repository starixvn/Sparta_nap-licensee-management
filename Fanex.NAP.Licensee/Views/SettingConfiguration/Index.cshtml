@using System.Web.Optimization;
@{
    ViewBag.Title = "Default";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">Licensee Setting</li>
    </ul>
}
<div ng-app="settingConfiguration" ng-controller="settingConfigurationCtrl">
    <form role="form" action="/" class="form-inline col-sm-12 filter-form bet-setting">
    <div id="errMsgBox" class="message error hidden">
        <i class="icon-error"></i>
        <div class="txt-content">
            Please select at least one currency and one product!</div>
    </div>
    <div style="float: left">
        <div class="form-group">
            <label for="licensee" class="col-md-3">
                Licensee</label>
            <select ng-options="item.Name for item in filterData.licensees track by item.Name"
                ng-model="filterData.selectedLicensee" ng-change="selectedLicenseeChanged()"
                id="licensee" class="col-md-3 width-160">
            </select>
        </div>
        <div class="form-group">
            <label for="currency">
                Super Username</label>
            <select ng-options="item.Name for item in filterData.superLicensees track by item.Id"
                ng-model="filterData.selectedSuperLicensee" id="super-username" class="col-md-3 width-160">
            </select>
        </div>
    </div>
    <div class="clearfix">
    </div>
    <div class="clearfix" style="float: left">
        <div class="form-group">
            <label for="currency">
                Select Product</label>
            <select ng-options="item.Name for item in filterData.productTypes track by item.Id"
                ng-model="filterData.selectedProductType" ng-change="selectedProductTypeChanged()"
                id="product-type" class="col-md-3 width-160">
            </select>
        </div>
        <div class="form-group">
            <label for="currency">
                Select Function</label>
            <select ng-options="item for item in filterData.selectedProductType.Functions track by item"
                ng-model="filterData.selectedFunction" ng-init="filterData.selectedFunction = filterData.selectedProductType.Functions[0]"
                id="product-function" class="col-md-3 width-160">
            </select>
        </div>
    </div>
    <div class="clearfix">
    </div>
    <div class="form-group">
        <input type="button" id="Select" value="Select" class="btn-primary" ng-click="selectEventHandler()" />
    </div>
    </form>
    <!--Dynamic View-->
    <div class="clearfix">
    </div>
    <div ng-view>
    </div>
</div>
@section FooterJs
{
    <script src="@Url.Content("~/Scripts/angular/angular.min.js")" type="text/javascript" ></script>
    <script src="@Url.Content("~/Scripts/angular/angular-route.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/controllers/settingConfiguration/settingConfiguration.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/controllers/settingConfiguration/settingConfigurationController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/controllers/settingConfiguration/editPTController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/controllers/settingConfiguration/reviewPTController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/controllers/settingConfiguration/editCommController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/controllers/settingConfiguration/reviewCommController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/services/filterDataService.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Page/app/services/shareSettingsService.js")" type="text/javascript"></script>
}
