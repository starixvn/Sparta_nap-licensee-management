@{
    ViewBag.Title = "Default";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Bet Setting</li>
        <li class="current">Licensee Setting</li>
    </ul>
}
<div ng-app="settingConfiguration" ng-controller="settingConfigurationCtrl">
    <form role="form" action="/" class="form-inline col-sm-12 filter-form bet-setting">
    <div id="errMsgBox" class="message error hidden">
        <i class="icon-error"></i>
        <div class="txt-content">
            Please select at least one currency and one product!</div>
    </div>
    <div class="form-group">
        <label for="licensee">
            Licensee</label>
        <select ng-model="filterData.selectedLicensee" ng-options="item.Name for item in filterData.licensees track by item.Name"
            id="licensee" class="width-160">
        </select>
    </div>
    <div class="form-group">
        <label for="currency">
            Super Username</label>
        <select id="super-username" class="width-160">
        </select>
    </div>
    <div class="form-group">
        <label for="currency">
            Select Product</label>
        <select id="select-product" class="width-160">
        </select>
    </div>
    <div class="form-group">
        <label for="currency">
            Select Function</label>
        <select id="select-function" class="width-160">
        </select>
    </div>
    <div class="form-group">
        <input type="button" id="generate" value="Select" class="btn-primary" />
    </div>
    </form>
    <div id="report-content">
        <div id="gridId" class="freegrid  content-grid">
        </div>
    </div>
    <div class="form-group">
        <input type="button" id="tt" value="goToComm" class="btn-primary" ng-click="goToComm()" />
    </div>
    <div class="form-group">
        <input type="button" id="tt" value="goToEdit" class="btn-primary" ng-click="goToEdit()" />
    </div>
    <!--Dynamic View-->
    <div ng-view>
    </div>
</div>
@section FooterJs
{
    <script src="@Url.Content("~/Scripts/angular/angular.min.js")" type="text/javascript" ></script>
    <script src="@Url.Content("~/Scripts/angular/angular-route.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/app/components/SettingConfiguration/settingConfiguration.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/app/components/SettingConfiguration/settingConfigurationController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/app/components/SettingConfiguration/editPTController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/app/components/SettingConfiguration/reviewPTController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/app/components/SettingConfiguration/editCommController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/app/components/SettingConfiguration/reviewCommController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/app/shared/shareSettingsService.js")" type="text/javascript"></script>
}
