<div ng-controller="reviewBSSportsbookCtrl" class="filter-form">
    <h4>Review Bet Setting Sportsbook <span class="text-highlight">({{header}})</span></h4>
    <label ng-if="!option" class="checkbox-inline">
        <input ng-model="reviewBS.IsApplyForMembersChecked" disabled type="checkbox">
        Apply for players
    </label>
    <div ng-style="!option && {'margin-left': '20px'}">
        <input ng-model="reviewBS.applyForMember" disabled type="radio" id="allPlayers" name="players" value="1" />
        <label style="font-weight: normal;" for="allPlayers">All players (Existing and New players)</label><br>
        <input ng-model="reviewBS.applyForMember" disabled type="radio" id="newPlayers" name="players" value="2" />
        <label style="font-weight: normal;" for="newPlayers">New players only</label>
    </div>
    <table class="table table-bordered table-setting">
        <thead>
        <tr>
            <th>
                All sports
            </th>
            <th class="width-150">
                Min Bet
            </th>
            <th class="width-150">
                Max Bet
            </th>
            <th class="width-150">
                Max Per Match
            </th>
            <th class="width-150">
                Max Payout Per Match
            </th>
            <th>
                Updated
            </th>
            <th ng-if="buttonStatus.isUpdated">
                Status
            </th>
            <th ng-if="buttonStatus.isUpdated">
                Message
            </th>
        </tr>
        </thead>
        <tbody>
        <tr ng-repeat="item in reviewBS.BSRows">
            <td>
                {{item.BetTypeName}}
            </td>
            <td>
                {{item.MinBet | number}}
            </td>
            <td>
                {{item.MaxBet | number}}
            </td>
            <td>
                {{item.MaxPerMatch | number}}
            </td>
            <td>
                {{item.MaxPayoutPerMatch | number}}
            </td>
            <td>
                {{item.IsRowSelected === true? 'X': ''}}
            </td>
            <td ng-if="buttonStatus.isUpdated">
                <span class="glyphicon {{item.Status}}"></span>
            </td>
            <td ng-if="buttonStatus.isUpdated">
                {{item.Message}}
            </td>
        </tr>
        </tbody>
    </table>
    <div ng-if="isShowDBS()">
        <h4>Review Default Bet Setting Sportsbook For New Player</h4>

        <table class="table table-bordered table-setting">
            <thead>
            <tr>
                <th>
                    All sports
                </th>
                <th class="width-150">
                    Min Bet
                </th>
                <th class="width-150">
                    Max Bet
                </th>
                <th class="width-150">
                    Max Per Match
                </th>
                <th class="width-150">
                    Max Payout Per Match
                </th>
            </tr>
            </thead>
            <tbody>
            <tr ng-repeat="item in reviewBS.DBSRows">
                <td>
                    {{item.SportTypeName}}
                </td>
                <td>
                    {{item.MinBet | number}}
                </td>
                <td>
                    {{item.MaxBet | number}}
                </td>
                <td>
                    {{item.MaxPerMatch | number}}
                </td>
                <td>
                    {{item.MaxPayoutPerMatch | number}}
                </td>
            </tr>
            </tbody>
        </table>
    </div>
    <input type="button" value="Update" class="btn btn-primary" ng-click="updateBS()" ng-disabled="buttonStatus.isUpdated" />
    <input type="button" value="Back" class="btn btn-primary" ng-click="backEditBS()" ng-disabled="!buttonStatus.isButtonEnable" />
</div>
