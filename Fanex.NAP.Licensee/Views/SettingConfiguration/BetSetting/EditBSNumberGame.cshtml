<div ng-controller="editBSNumberGameCtrl" class="filter-form">
    <h4>Edit Bet Setting Number Game</h4>
    <label class="checkbox-inline">
        <input ng-change="applyExistingMembers()" ng-model="editBS.IsApplyExistingMemberChecked" type="checkbox">
        Apply existing menbers
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th>
                    Min Bet
                </th>
                <th>
                    Max Bet
                </th>
                <th>
                    Max Per Match
                </th>
                <th>
                    Max Per Ball
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in editBS.BSRows">
                <td>
                    <input type="text" ng-attr-min="0" ng-attr-max="{{item.MaxBet}}" bs-validation ng-model="item.MinBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled"
                        bs-validation="MinBet" />
                </td>
                <td>
                    <input type="text" ng-attr-min="{{item.MinBet}}" ng-attr-max="{{item.MaxPerMatch}}" bs-validation ng-model="item.MaxBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled"
                        bs-validation="MaxBet" />
                </td>
                <td>
                    <input type="text" ng-attr-min="{{item.MaxBet}}" ng-attr-max="{{item.MaxPerBall}}" bs-validation ng-model="item.MaxPerMatch" ng-disabled="!item.IsRowSelected || item.IsRowDisabled"
                       bs-validation="MaxPerMatch"  />
                </td>
                <td>
                    <input type="text" ng-attr-min="{{item.MaxPerMatch}}" ng-attr-max="*" bs-validation ng-model="item.MaxPerBall" ng-disabled="!item.IsRowSelected || item.IsRowDisabled"
                        bs-validation="MaxPerBall" />
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!buttonStatus.isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
