<div ng-controller="reviewBSRacingCtrl" class="filter-form">
    <h4>Review Bet Setting Racing</h4>
    <h5>
        Apply existing members: {{reviewBS.IsApplyExistingMemberChecked === true ? "Yes"
        : "No"}}
    </h5>
    <div>
        <table class="table table-bordered table-setting">
            <thead>
                <tr>
                    <th colspan="2">
                        All sports
                    </th>
                    <th class="width-150">
                        Min Bet
                    </th>
                    <th class="width-150">
                        Max Bet
                    </th>
                    <th class="width-150">
                        Max Per Match
                    </th>
                    <th>
                        Enable Product
                    </th>
                    <th>
                        Enable Members
                    </th>
                    <th>
                        Updated
                    </th>
                    <th ng-if="buttonStatus.isUpdated">
                        Status
                    </th>
                    <th ng-if="buttonStatus.isUpdated">
                        Message
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in reviewBS.BSRows">
                    <td ng-if="item.RowSpan != -1" rowspan="{{item.RowSpan}}">
                        {{item.SportTypeName}}
                    </td>
                    <td>
                        {{item.BetTypeName}}
                    </td>
                    <td>
                        {{item.MinBet}}
                    </td>
                    <td>
                        {{item.MaxBet}}
                    </td>
                    <td>
                        {{item.MaxPerMatch}}
                    </td>
                    <td>
                        {{item.IsSuperChecked === true? 'X': ''}}
                    </td>
                    <td>
                        {{item.IsDownlineChecked === true? 'X': ''}}
                    </td>
                    <td>
                        {{item.IsRowSelected === true? 'X': ''}}
                    </td>
                     <td ng-if="buttonStatus.isUpdated">
                        <span class="glyphicon {{item.Status}}"></span>
                    </td>
                    <td ng-if="buttonStatus.isUpdated">
                        {{item.Message}}
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="button" value="Update" class="btn btn-primary" ng-click="updateBS()" ng-disabled="buttonStatus.isUpdated" />
                        <input type="button" value="Back" class="btn btn-primary" ng-click="backEditBS()" ng-disabled="!buttonStatus.isButtonEnable" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
