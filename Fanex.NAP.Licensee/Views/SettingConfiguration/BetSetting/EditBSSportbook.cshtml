<div ng-controller="editBSSportbookCtrl" class="filter-form">
<form  name="myForm">
    <h4>Edit Bet Setting Sportsbook <span class="text-highlight">({{supperUserName}})</span></h4>
    <label class="checkbox-inline">
        <input ng-change="applyExistingMembers()" ng-model="editBS.IsApplyExistingMemberChecked" type="checkbox">
        Apply existing members
    </label>
    <label class="checkbox-inline">
        <input ng-change="copyAllFromOne()" ng-model="isCopyAll" type="checkbox">
        Copy all Bet Setting from 1st row
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" ng-model="isAllSportChecked" ng-change="checkAllSports()" />
                    All sports
                </th>
                <th>
                    Min Bet
                </th>
                <th>
                    Max Bet
                </th>
                <th>
                    Max Per Match
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in editBS.BSRows">
                <td>
                    <label style="font-weight: normal; display: inline;">
                        <input type="checkbox" ng-model="item.IsRowSelected" ng-disabled="item.IsRowDisabled" />
                        {{item.SportTypeName}}
                    </label>
                </td>
                <td>
                    <input name="MinBet" type="text" ng-attr-min="0" ng-attr-max="{{item.MaxBet}}" bs-validation ng-model="item.MinBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                </td>
                <td>
                    <input name="MaxBet" type="text"  ng-attr-min="{{item.MinBet}}" ng-attr-max="{{item.MaxPerMatch}}"  bs-validation ng-model="item.MaxBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                </td>
                <td>
                    <input name="MaxPerMatch" type="text" ng-attr-min="{{item.MaxBet}}" ng-attr-max="*"  bs-validation ng-model="item.MaxPerMatch" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!buttonStatus.isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</form>
</div>
