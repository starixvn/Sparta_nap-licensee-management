<div ng-controller="editBSSportbookCtrl" class="filter-form">
<form  name="myForm">
    <h4>Edit Bet Setting Sportsbook <span class="text-highlight">({{header}})</span></h4>
    <label class="checkbox-inline">
        <input ng-change="applyExistingMembers()" ng-model="editBS.IsApplyExistingMemberChecked" type="checkbox">
        Apply existing members
    </label>
    <label class="checkbox-inline">
        <input ng-change="copyAllFromOne()" ng-model="isCopyAll" type="checkbox">
        Copy all Bet Setting from 1st row
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" ng-model="isAllSportChecked" ng-change="checkAllSports()" />
                    All sports
                </th>
                <th>
                    Min Bet
                </th>
                <th>
                    Max Bet
                </th>
                <th>
                    Max Per Match
                </th>
                <th>
                    Max Payout Per Match
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in editBS.BSRows">
                <td>
                    <label style="font-weight: normal; display: inline;">
                        <input type="checkbox" ng-model="item.IsRowSelected" ng-disabled="item.IsRowDisabled" />
                        {{item.SportTypeName}}
                    </label>
                </td>
                <td>
                    <input name="AgentMinBet" type="text" ng-attr-min="0" ng-attr-max="{{item.AgentMaxBet}}" bs-validation ng-model="item.AgentMinBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                    <input style="border: none !important; text-align: left !important; background: none;" name="MinBet" type="text" ng-attr-min="0" ng-attr-max="*" ng-attr-max2="*" bs-validation ng-model="item.MinBet" ng-disabled="true" />
                </td>
                <td>
                    <input name="AgentMaxBet" type="text" ng-attr-min="{{item.AgentMinBet}}" ng-attr-max="{{item.AgentMaxPerMatch}}" bs-validation ng-model="item.AgentMaxBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                    <input style="border: none !important; text-align: left !important; background: none;" name="MaxBet" type="text" ng-attr-min="0" ng-attr-max="*" ng-attr-max2="*" bs-validation ng-model="item.MaxBet" ng-disabled="true" />
                </td>
                <td>
                    <input name="AgentMaxPerMatch" type="text" ng-attr-min="{{item.AgentMaxBet}}" ng-attr-max="*" bs-validation ng-model="item.AgentMaxPerMatch" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                    <input style="border: none !important; text-align: left !important; background: none;" name="MaxPerMatch" type="text" ng-attr-min="0" ng-attr-max="*" ng-attr-max2="*" bs-validation ng-model="item.MaxPerMatch" ng-disabled="true" />
                </td>
                <td>
                    <input name="AgentMaxPayoutPerMatch" type="text" ng-attr-min="{{item.AgentMaxPerMatch}}" ng-attr-max="*" bs-validation ng-model="item.AgentMaxPayoutPerMatch" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                    <input style="border: none !important; text-align: left !important; background: none;" name="MaxPayoutPerMatch" type="text" ng-attr-min="0" ng-attr-max="*" ng-attr-max2="*" bs-validation ng-model="item.MaxPayoutPerMatch" ng-disabled="true" />
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!buttonStatus.isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</form>
</div>
