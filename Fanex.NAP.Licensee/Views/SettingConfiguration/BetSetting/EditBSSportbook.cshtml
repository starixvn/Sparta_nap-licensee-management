<div ng-controller="editBSSportbookCtrl" class="filter-form">
<form  name="myForm">
    <h2>
        Edit Bet Setting Sportbook</h2>
    <label class="checkbox-inline">
        <input ng-change="applyExistingMembers()" ng-model="editBS.IsApplyExistingMemberChecked" type="checkbox">
        Apply existing menbers
    </label>
    <label class="checkbox-inline">
        <input ng-change="copyAllFromOne()" ng-model="isCopyAll" type="checkbox">
        Copy all Bet Setting from 1st row
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" ng-model="isAllSportChecked" ng-change="checkAllSports()" />
                    All sports
                </th>
                <th>
                    Min Bet
                </th>
                <th>
                    Max Bet
                </th>
                <th>
                    Max Per Match
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in editBS.BSRows">
                <td>
                    <label style="font-weight: normal; display: inline;">
                        <input type="checkbox" ng-model="item.IsRowSelected" ng-disabled="item.IsRowDisabled" />
                        {{item.SportTypeName}}
                    </label>
                </td>
                <td>
                    <input name="MinBet" type="text" bs-validation="MinBet" ng-model="item.MinBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" only-integer />
                </td>
                <td>
                    <input name="MaxBet" type="text" bs-validation="MaxBet" ng-model="item.MaxBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" only-integer />
                </td>
                <td>
                    <input name="MaxPerMatch" type="text" bs-validation="MaxPerMatch" ng-model="item.MaxPerMatch" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" only-integer />
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</form>
</div>
