<div ng-controller="reviewBSKenoCtrl" class="filter-form">
    <h4>Review Bet Setting Keno</h4>
    <h5>
        Apply existing members: {{reviewBS.IsApplyExistingMemberChecked === true ? "Yes"
        : "No"}}
    </h5>
    <h5>
        Enable Product: {{reviewBS.IsEnableChecked === true ? "Yes" : "No"}}
    </h5>
    <h5>
        Enable Downline: {{reviewBS.IsDownlineChecked === true ? "Yes" : "No"}}
    </h5>
    <div>
        <table class="table table-bordered table-setting">
            <thead>
                <tr>
                    <th>
                        Sport
                    </th>
                    <th>
                        Min Bet
                    </th>
                    <th>
                        Max Bet
                    </th>
                    <th>
                        Max Bet Per Draw
                    </th>
                    <th>
                        Updated
                    </th>
                    <th ng-if="buttonStatus.isUpdated">
                        Status
                    </th>
                    <th ng-if="buttonStatus.isUpdated">
                        Message
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in reviewBS.BSRows">
                    <td>
                        Keno
                    </td>
                    <td>
                        {{item.MinBet}}
                    </td>
                    <td>
                        {{item.MaxBet}}
                    </td>
                    <td>
                        {{item.MaxPerMatch}}
                    </td>
                    <td>
                        {{item.IsRowSelected === true? 'X': ''}}
                    </td>
                     <td ng-if="buttonStatus.isUpdated">
                        <span class="glyphicon {{item.Status}}"></span>
                    </td>
                    <td ng-if="buttonStatus.isUpdated">
                        {{item.Message}}
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="button" value="Update" class="btn btn-primary" ng-click="updateBS()" ng-disabled="buttonStatus.isUpdated" />
                        <input type="button" value="Back" class="btn btn-primary" ng-click="backEditBS()" ng-disabled="!buttonStatus.isButtonEnable" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
