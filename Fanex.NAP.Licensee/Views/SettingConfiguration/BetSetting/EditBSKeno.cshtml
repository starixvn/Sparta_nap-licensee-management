<div ng-controller="editBSKenoCtrl" class="filter-form">
    <h2>
        Edit Bet Setting Keno</h2>
    <label class="checkbox-inline">
        <input ng-change="applyExistingMembers()" ng-model="editBS.IsApplyExistingMemberChecked" type="checkbox">
        Apply existing menbers
    </label>
     <label class="checkbox-inline">
        <input ng-model="editBS.IsEnableChecked" ng-disabled="editBS.IsEnableDisabled" ng-click="changeNextButtonStatus()" type="checkbox">
        Enable Product
    </label>
    <label class="checkbox-inline">
        <input ng-model="editBS.IsDownlineChecked" ng-disabled="editBS.IsDownlineDisabled"
            type="checkbox">
        Enable Downline
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th>
                    All sports
                </th>
                <th>
                    Min Bet
                </th>
                <th>
                    Max Bet
                </th>
                <th>
                   Max Bet Per Draw
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in editBS.BSRows">
                <td>
                    <label style="font-weight: normal; display: inline;">
                        {{item.BetTypeName}}
                    </label>
                </td>
                <td>
                    <input type="text" ng-model="item.MinBet" bs-validation="MinBet" only-integer />
                </td>
                <td>
                    <input type="text" ng-model="item.MaxBet" bs-validation="MaxBet" only-integer />
                </td>
                <td>
                    <input type="text" ng-model="item.MaxPerMatch" bs-validation="MaxPerMatch" only-integer />
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
