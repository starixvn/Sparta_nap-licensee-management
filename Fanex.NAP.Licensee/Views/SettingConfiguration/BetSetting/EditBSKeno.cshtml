<div ng-controller="editBSKenoCtrl" class="filter-form">
    <h4>Edit Bet Setting Keno <span class="text-highlight">({{supperUserName}})</span></h4>
    <label class="checkbox-inline">
        <input ng-change="applyForMembers()" ng-model="editBS.IsApplyForMembersChecked" type="checkbox">
        Apply existing members
    </label>
     <label class="checkbox-inline">
        <input ng-model="editBS.IsEnableChecked" ng-disabled="editBS.IsEnableDisabled" ng-click="changeNextButtonStatus()" type="checkbox">
        Enable Product
    </label>
    <label class="checkbox-inline">
        <input ng-model="editBS.IsDownlineChecked" ng-disabled="editBS.IsDownlineDisabled || !editBS.IsEnableChecked"
            ng-click="enableMembers()" type="checkbox">
        Enable Members
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th>
                    Sport
                </th>
                <th>
                    Min Bet
                </th>
                <th>
                    Max Bet
                </th>
                <th>
                   Max Bet Per Draw
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in editBS.BSRows">
                <td>
                    <label style="font-weight: normal; display: inline;">
                        Keno
                    </label>
                </td>
                <td>
                    <input type="text" ng-attr-uplinemin="*" ng-attr-uplinemax="*" ng-attr-min="0" ng-attr-max="{{item.MaxBet | number}}" bs-validation ng-model="item.MinBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled"/>
                </td>
                <td>
                    <input type="text" ng-attr-uplinemin="*" ng-attr-uplinemax="*" ng-attr-min="{{item.MinBet | number}}" ng-attr-max="{{item.MaxPerMatch | number}}" bs-validation ng-model="item.MaxBet" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                </td>
                <td>
                    <input type="text" ng-attr-uplinemin="*" ng-attr-uplinemax="*" ng-attr-min="{{item.MaxBet | number}}" ng-attr-max="*" bs-validation ng-model="item.MaxPerMatch" ng-disabled="!item.IsRowSelected || item.IsRowDisabled" />
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!buttonStatus.isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
