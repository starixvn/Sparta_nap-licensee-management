<div ng-controller="editBSKenoCtrl" class="filter-form">
    <h2>
        Edit Bet Setting Keno</h2>
    <label class="checkbox-inline">
        <input ng-model="editBS.IsApplyExistingMemberChecked" type="checkbox">
        Apply existing menbers
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th>
                    All sports
                </th>
                <th>
                    Min Bet
                </th>
                <th>
                    Max Bet
                </th>
                <th>
                    Max Per Match
                </th>
                <th>
                    Super
                </th>
                <th>
                    Downlines
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in editBS.BSRows">
                <td>
                    <label style="font-weight: normal; display: inline;">
                        {{item.BetTypeName}}
                    </label>
                </td>
                <td>
                    <input type="text" ng-model="item.MinBet" only-integer />
                </td>
                <td>
                    <input type="text" ng-model="item.MaxBet" only-integer />
                </td>
                <td>
                    <input type="text" ng-model="item.MaxPerMatch" only-integer />
                </td>
                <td>
                    <input type="checkbox" ng-model="item.IsSuperChecked" ng-disabled="item.IsSuperDisabled" />
                </td>
                <td>
                    <input type="checkbox" ng-model="item.IsDownlineChecked" ng-disabled="item.IsDownlineDisabled" />
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewBS()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
