<div class="col-md-3 filter-form">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th colspan="2">
                    Position Taking
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="col-md-6">
                    {{editPTData.ProductName}}
                </td>
                <td>
                    <select ng-options="item for item in editPTData.PositionTakings track by item" ng-model="editPTData.SelectedPositionTaking"
                        class="width-160">
                    </select>
                </td>
            </tr>
            <tr>
                <td class="col-md-12" colspan="2">
                    <input ng-click="nextReviewPT()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!buttonStatus.isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
