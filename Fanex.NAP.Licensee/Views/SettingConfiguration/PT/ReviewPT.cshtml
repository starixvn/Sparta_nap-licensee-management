<div class="clearfix">
</div>
<div class="filter-form">
    <div>
        The values will be updated to supers <strong>{{reviewPTData.SuperUsername}}</strong>
    </div>
    <div>
        Original PT: <strong>{{reviewPTData.OrgPT === "-1" ? "None" : reviewPTData.OrgPT}}</strong>
    </div>
    <div>
        Current PT: <strong>{{reviewPTData.CurPT}}</strong>
    </div>
    <div class="form-group">
        <input type="button" value="Update" class="btn-primary" ng-click="updatePT()" ng-disabled="buttonStatus.isUpdated" />
        <input type="button" value="Back" class="btn-primary" ng-click="backEditPT()" ng-disabled="!buttonStatus.isButtonEnable" />
    </div>
    <div class="col-sm-12 alert" ng-class="isSuccess?'alert-success':'alert-danger'" ng-show="isFinish" role="alert">
        {{ptMessage}}
    </div>
</div>
