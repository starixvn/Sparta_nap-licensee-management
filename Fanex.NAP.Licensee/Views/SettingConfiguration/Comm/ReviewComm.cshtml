<div class="filter-form">
    <div>
        The values will be updated to supers <strong>{{reviewCommData.SuperUsername}}</strong>
    </div>
    <br />
    <div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th colspan="2">
                    </th>
                    <th>
                        Org Comm
                    </th>
                    <th>
                        Cur Comm
                    </th>
                    <th>
                        Updated
                    </th>
                    <th ng-if="IsUpdating">
                        Status
                    </th>
                    <th ng-if="IsUpdating">
                        Message
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in reviewCommData.OrgComm">
                    <td ng-if="item.RowSpan != -1" rowspan="{{item.RowSpan}}">
                        {{item.SportTypeName}}
                    </td>
                    <td>
                        {{item.BetTypeName}}
                    </td>
                    <td>
                        {{item.SelectedComm}}
                    </td>
                    <td>
                        {{reviewCommData.CurComm[$index].SelectedComm}}
                    </td>
                    <td>
                        {{reviewCommData.CurComm[$index].IsChecked === true? 'X': ''}}
                    </td>
                    <td ng-if="IsUpdating">
                        <span class="glyphicon {{reviewCommData.CurComm[$index].Status}}"></span>
                    </td>
                    <td ng-if="IsUpdating">
                        {{reviewCommData.CurComm[$index].Message}}
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="button" value="Update" class="btn-primary" ng-click="updateComm()" />
                        <input type="button" value="Back" class="btn-primary" ng-click="backEditComm()" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
