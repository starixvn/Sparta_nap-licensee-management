<div class="col-md-5 filter-form">
    <h2>Edit Commission Setting Racing</h2>
    <label class="checkbox-inline">
        <input ng-change="copyAll()" ng-model="isCopyAll" type="checkbox" id="copy-vs" data-key="#vs-table">
        Copy all Commission Setting from 1st row
    </label>
    <table class="table table-bordered table-setting">
        <thead>
            <tr>
                <th colspan="3">
                </th>
                <th>
                    Comm
                </th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="item in EditCommRows">
                <td ng-if="item.RowSpan != -1" rowspan="{{item.RowSpan}}" style="vertical-align: middle">
                    {{item.SportTypeName}}
                </td>
                <td>
                    {{item.BetTypeName}}
                </td>
                <td>
                    <input type="checkbox" ng-model="item.IsChecked" ng-disabled="item.IsDisabled" />
                </td>
                <td>
                    <select ng-options="comm for comm in item.Comms track by comm" ng-model="item.SelectedComm"
                        ng-change="copyComm()" ng-disabled="!item.IsChecked || item.IsDisabled">
                    </select>
                </td>
            </tr>
            <tr>
                <td>
                    <input ng-click="nextReviewComm()" type="button" value="Next" class="btn btn-primary"
                        ng-disabled="!buttonStatus.isNextEnabled" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
