@model Fanex.NAP.Licensee.Model.ViewModel.DefaultBetSetting.SingleDefaultBetSettingViewModel
<input type="hidden" id="has-setting" value="@Model.HasSetting.ToString()" />
@if (Model.Sportsbook.Count > 0)
{
    var sbCount = 0;
    <div class="row group">
        <div class="col-sm-12 title-group" id="sb-area">
            <i class="icon-collapse" data-key="area-icon"></i>Sportsbook
        </div>
        <div class="col-sm-12 content" data-key="area-content">
            <label class="checkbox-inline">
                <input type="checkbox" id="copy-sb" data-key="#sb-table">
                Copy all Bet Setting from 1st row
            </label>
            <table class="table table-bordered table-setting" id="sb-table">
                <thead>
                    <tr>
                        <th class="col20">
                            Sport Type
                        </th>
                        <th class="col20">
                            Min Bet
                        </th>
                        <th class="col20">
                            Max Bet
                        </th>
                        <th class="col20">
                            Max Per Match
                        </th>
                        <th class="col20">
                            Max Payout Per Match
                        </th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var sb in Model.Sportsbook)
                    {
                        <tr class="@(sbCount == 0 ? "first" : string.Empty)" data-code="@(sbCount == 0 ? "sb" : string.Empty)" data-sport="@sb.SportOrGame.Id" data-bettype="@sb.BetType">
                            <td>
                                @sb.SportOrGame.Name
                            </td>
                            <td>
                                <input data-key="MinBet" maxlength="12" type="text" value="@(sb.MinBet.HasValue ? sb.MinBet.Value.ToString() : string.Empty)" class="txt-max" />
                            </td>
                            <td>
                                <input data-key="MaxBet" maxlength="12" type="text" value="@(sb.MaxBet.HasValue ? sb.MaxBet.Value.ToString() : string.Empty)" class="txt-max" />
                            </td>
                            <td>
                                <input data-key="MaxPerMatch" maxlength="12" type="text" value="@(sb.MaxPerMatch.HasValue ? sb.MaxPerMatch.Value.ToString() : string.Empty)" class="txt-max" />
                            </td>
                            <td>
                                <input data-key="MaxPayoutPerMatch" maxlength="12" type="text" value="@(sb.MaxPayoutPerMatch.HasValue ? sb.MaxPayoutPerMatch.Value.ToString() : string.Empty)" class="txt-max" />
                            </td>
                        </tr>
                        sbCount++;
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (Model.NumberGame.Count > 0)
{
    <div class="row group">
        <div class="col-sm-12 title-group" id="ng-area">
            <i class="icon-collapse" data-key="area-icon"></i>Number Game
        </div>
        <div class="col-sm-12 content" data-key="area-content">
            <table class="table table-bordered table-setting" id="ng-table">
                <thead>
                    <tr>
                        <th class="col20">
                        </th>
                        <th class="col20">
                            Max Bet
                        </th>
                        <th class="col30">
                            Max Per Match
                        </th>
                        <th class="col30">
                            Max Per Ball
                        </th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var ng in Model.NumberGame)
                    {
                        <tr data-sport="@ng.SportOrGame.Id" data-bettype="@ng.BetType">
                            <td>
                                @ng.SportOrGame.Name
                            </td>
                            <td>
                                <input data-key="MaxBet" maxlength="12" type="text" value="@(ng.MaxBet.HasValue ? ng.MaxBet.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                            </td>
                            <td>
                                <input data-key="MaxPerMatch" maxlength="12" type="text" value="@(ng.MaxPerMatch.HasValue ? ng.MaxPerMatch.Value.ToString() : string.Empty)" class="width-170 txt-max" />
                            </td>
                            <td>
                                <input data-key="MaxPerBall" maxlength="12" type="text" value="@(ng.MaxPerBall.HasValue ? ng.MaxPerBall.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (Model.Keno.Count > 0)
{
    var knCount = 0;

    <div class="row group">
        <div class="col-sm-12 title-group" id="kn-area">
            <i class="icon-collapse" data-key="area-icon"></i>Keno
        </div>
        <div class="col-sm-12 content" data-key="area-content">
            @if (Model.Keno.Count > 1)
            {
                <label class="checkbox-inline">
                    <input type="checkbox" id="copy-kn" data-key="#kn-table">
                    Copy all Bet Setting from 1st row
                </label>
            }
            <table class="table table-bordered table-setting" id="kn-table">
                <thead>
                    <tr>
                        <th class="col20">
                            Game Type
                        </th>
                        <th class="col40">
                            Max Bet
                        </th>
                        <th class="col40">
                            Max Per Match
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kn in Model.Keno)
                    {
                        <tr class="@(knCount == 0 ? "first" : string.Empty)" data-code="@(knCount == 0 ? "kn" : string.Empty)" data-sport="@kn.SportOrGame.Id" data-bettype="@kn.BetType">
                            <td>
                                @kn.SportOrGame.Name
                            </td>
                            <td>
                                <input data-key="MaxBet" maxlength="12" type="text" value="@(kn.MaxBet.HasValue ? kn.MaxBet.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                            </td>
                            <td>
                                <input data-key="MaxPerMatch" maxlength="12" type="text" value="@(kn.MaxPerMatch.HasValue ? kn.MaxPerMatch.Value.ToString() : string.Empty)" class="width-240 txt-max" />
                            </td>
                        </tr>
                        knCount++;
                    }
                </tbody>
            </table>
        </div>
    </div>
}