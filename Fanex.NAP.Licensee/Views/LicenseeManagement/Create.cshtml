@using System.Web.Optimization;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.NAP.Licensee.Model.ViewModel.CreateLicenseeViewModel
@section HeadCss {
    @Styles.Render("~/bundles/licenseeCss")
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Manage Licensee</li>
        <li class="current">Create Licensee</li>
    </ul>
}
@{
    var canNotCreateLicensee = Model.Licensees.Count() == 0;    
    var disableLicenseeCreator = canNotCreateLicensee ? "disabled" : string.Empty;
    var notAllowClass = canNotCreateLicensee ? "cursor-disabled" : string.Empty;
}
<form role="form" action="/" class="form-inline col-sm-12 filter-form bet-setting">
<div id="errMsgBox" class="message error hidden">
    <i class="icon-error"></i>
    <div class="txt-content">
        Please select at least one product!</div>
</div>
<table cellpadding="0" cellspacing="0" class="filter-table">
    <tr>
        <td style="text-align: right">
            <label class="filter-name">
                Licensee Group:</label>
        </td>
        <td>
            <select id="licensee-type-filter">
                @foreach (var type in Model.LicenseeTypes)
                {
                    <option value="@type.LicenseeTypeId">@type.LicenseeTypeName</option>
                }
            </select>
        </td>
        <td style="text-align: right">
            <label class="filter-name">
                Licensee name:</label>
        </td>
        <td>
            <select id="licensee-name-filter"  class="@notAllowClass" @disableLicenseeCreator>
                @foreach (var licensee in Model.Licensees)
                {
                    <option value="@licensee.LicenseeName">@licensee.LicenseeName</option>
                }
            </select>
            @if (canNotCreateLicensee)
            {
                <span style="color:#ff0000;">Create dummy account before creating licensee.</span>
            }
        </td>
    </tr>
    <tr>
        <td style="text-align: right">
            <label class="filter-name">
                Product:</label>
        </td>
        <td colspan="3">
            <div id="product-filter" class="filter">
                @foreach (var product in Model.Products)
                {
                    <input id="@product.ProductPrefix" value="@product.ProductPrefix" type="checkbox" />
                    <label for="@product.ProductPrefix">
                        <span class="filter-text">@product.ProductName</span>
                    </label>
                }
            </div>
        </td>
    </tr>
    <tr>
        <td style="text-align: right">
            <label class="filter-name">
                Special licensee functions:</label>
        </td>
        <td>
            @if (Model.SpecialFunctions.Count() > 0)
            {
                <div id="special-licensee-function-area" class="filter">
                    <div id="special-licensee-function-selector">                        
                        <div class="view-content">Assign special functios</div>
                        <div id="popup-button">▼</div>
                    </div>
                    <div id="special-licensee-function-content" style="display: none; border: 1px solid #cccccc;">
                        @foreach (var function in Model.SpecialFunctions)
                        {
                            <input id="@function.FunctionId" type="checkbox" value="@function.FunctionId" />
                            <label for="@function.FunctionId">
                                <span class="filter-text">@function.Name</span></label>
                            <br />
                        }
                    </div>
                </div>
            }
            else
            {
                <span>No have any special function.</span>
            }
        </td>
        <td style="text-align: right">
            <label class="filter-name">
                Systems:</label>
        </td>
        <td>
            <div class="filter">
            @foreach (var system in Model.SystemInfo)
            {
                var checkedText = system.SystemName.Equals("LRF") ? "checked='checked'" : string.Empty;
                <input type="checkbox" disabled="disabled" @checkedText /><label class="system"><span class="filter-text">@system.SystemName</span></label>
            }
            </div>
        </td>
    </tr>
    <tr>
        <td style="text-align: right">
        </td>
        <td colspan="3">
            <input id="btn-create-licensee" type="button" class="btn-primary @notAllowClass" value="Create" @disableLicenseeCreator />
        </td>
    </tr>
</table>
</form>
<div class="note">
    <div class="note-text">* Note:
    </div>
    <div class="note-area">
        <label class="filter-name">
            - Systems: </label>Allow to enable only lrf on this page.
        <br />
        <label class="filter-name">
            - Licensee users: </label>Please note that all users who are IT users (isInternal = 0) will have all permissions except for "Account Management" function. Only user belongs to the selected Licensee Group can access these licensees. Only users who have the phrase "admin" or who have admin role have the right to access "Account Management".
        <br />
        <label class="filter-name">
            - Licensee user functions: </label>All functions of this licensee will be granted based on the products of this licensee and all users who have permission on this licensee can access all functions.
        <br />
        <label class="filter-name">
            - Currency users: </label>Users who have permission on this licensee can view all currencies.
    </div>
</div>
@section FooterJs
{
    @Scripts.Render("~/bundles/licenseeJs")
    <script type="text/javascript">
        $(document).ready(function () {
            ManageLicensee.initialize();
        });
    </script>
}
