@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@model Fanex.NAP.Licensee.Model.DTO.ITUser
@{
    ViewBag.Title = "Edit IT User";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";

    var serializer = new JavaScriptSerializer();
}

@section Headline {
    <ul class="breadcrumb title">
        <li>IT User Management</li>
        <li class="current">@(Model != null ? ("Edit " + Model.UserName) : "Invalid User")</li>
    </ul>
    <a class="btn-back" href="@Url.Content("~/ITUserManagement/Index")">← Back To List</a>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/user/user.css")
}
@section FooterJs{
    <script>
        var initialState = {
            user: @Html.Raw(serializer.Serialize(Model))
        }
    </script>
    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/editUser/editUser.js")
}

<div id="app-container"></div>