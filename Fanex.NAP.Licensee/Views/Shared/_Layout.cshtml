@using Fanex.NAP.Core.Configuration
<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8">
    <title>Licensee Management</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    @RenderSection("HeadCss", false)
    <link href="@Url.Content("~/Content/build/core.min.css")" rel='stylesheet' type='text/css' media='all' />
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~/")';
    </script>
</head>
<body>
    <div class="container-fluid page">
        <header class="row header">
            <a class="logo" href="@Url.Action("Index", "Home")">Licensee <span>Management</span>
            </a>
            @Html.Action("Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
            <div class="user-info">
                <span class="info-bar">Howdy, <span class="account-name">@ViewBag.Session.Username</span><span
                    class="caret"></span></span>
                <ul class="user-dropdown">
                    <li><a href="@Url.Content("~/UserLogin/Login/LogOut")">Sign Out</a></li>
                </ul>
            </div>
        </header>
        <section id="headline" class="row title-bar">
            @RenderSection("Headline", false)
        </section>
        <section id="body" class="row body">
            @RenderBody()
            <div id="loadingMsgBox" class="icon-loading hidden">
            </div>
        </section>
    </div>
    @RenderSection("Foot", false)
    <script src="@Url.Content("~/Scripts/build/core.min.js")"></script>
    @if (NapSettings.Settings.EnableReCheckIn)
    {
        <script src="@Url.Content("~/Scripts/build/recheckin.min.js")"></script>
    }
    @RenderSection("FooterJs", false)
</body>
</html>
