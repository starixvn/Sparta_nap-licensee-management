@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@model Fanex.NAP.Licensee.Model.ViewModel.LAPUser.UpdateUserViewModel
@{
    ViewBag.Title = "Create token";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";

    var serializer = new JavaScriptSerializer();
}

@section Headline {
    <ul class="breadcrumb title">
        <li>Vendor Info</li>
        <li>@Model.UserInfo.SiteName</li>
        <li class="current">Create Token</li>
    </ul>
    
    <a class="btn-back" href="@Url.Content("~/LicenseeVendor?VendorId=" + Model.UserInfo.SiteName)">← Back To List</a>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/createtoken/createtoken.css")
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/function/function.css")
}
@section FooterJs{
    <script>
        var initialState = {
            user: @Html.Raw(serializer.Serialize(Model.UserInfo)),
            timeRemaining: @Html.Raw(serializer.Serialize(Model.TimeRemaining)),
            isValid: @Html.Raw(serializer.Serialize(Model.IsValid)),
            funcPer: @Html.Raw(serializer.Serialize(Model.FuntionPermission)),
            currency: @Html.Raw(serializer.Serialize(Model.Currency)),
        }
    </script>

    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/createToken/createToken.js")
}

<div id="app-container"></div>