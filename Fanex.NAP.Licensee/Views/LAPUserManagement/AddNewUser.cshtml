@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@model Fanex.NAP.Licensee.Model.ViewModel.LAPUser.AddUserViewModel
@{
    ViewBag.Title = "Create new user";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";

    var serializer = new JavaScriptSerializer();
}

@section Headline {
    <ul class="breadcrumb title">
        <li>Vendor Info</li>
        <li>@Model.SiteName</li>
        <li class="current">Create new user</li>
    </ul>

    <a class="btn-back" href="@Url.Content("~/LicenseeVendor?VendorId=" + Model.VendorId)">← Back To List</a>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/createUser/createUser.css")
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/function/function.css")
}
@section FooterJs{
    <script>
            var initialState = {
                vendorId: @Html.Raw(serializer.Serialize(Model.VendorId)),
                siteName: @Html.Raw(serializer.Serialize(Model.SiteName)),
                userID: @Html.Raw(serializer.Serialize(Model.UserID)),
                isValid: @Html.Raw(serializer.Serialize(Model.IsValid)),
                isExist: @Html.Raw(serializer.Serialize(Model.IsExist)),
                funcPer: @Html.Raw(serializer.Serialize(Model.FuntionPermission)),
                currency: @Html.Raw(serializer.Serialize(Model.Currency))
            }
    </script>

    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/createUser/createUser.js")
}

<div id="app-container"></div>