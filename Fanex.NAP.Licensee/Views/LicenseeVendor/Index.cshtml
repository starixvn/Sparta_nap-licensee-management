@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@{
    ViewBag.Title = "Vendor Info";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";
}
@model IEnumerable<string>

@{
    var serializer = new JavaScriptSerializer();

    var functionKeyList = Model.Select(x => new { label = x, value = x }).ToList();
}
@section Headline {
    <ul class="breadcrumb title">
        <li>Vendor Info</li>
        <li class="current">Licensee Site</li>
    </ul> 
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/editvendor/editvendor.css")
}
@section FooterJs{
    <script>
            var initialState = {
                functionKeyList: @Html.Raw(serializer.Serialize(functionKeyList)),
                vendorId: @Html.Raw(serializer.Serialize(@ViewBag.VendorId))
            }
    </script>
    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/vendor/vendor.js")
}

<div id="app-container"></div>


