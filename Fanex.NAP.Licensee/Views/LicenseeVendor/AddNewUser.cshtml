@using Fanex.NAP.Licensee.App_Start
@using System.Web.Script.Serialization
@{
    ViewBag.Title = "Create new user";
    Layout = "~/Views/Shared/_ReactPageLayout.cshtml";

    var serializer = new JavaScriptSerializer();
}

@section Headline {
    <ul class="breadcrumb title">
        <li>Vendor Info</li>
        <li>@ViewBag.SiteName</li>
        <li class="current">Create new user</li>
    </ul>

    <a class="btn-back" href="@Url.Content("~/LicenseeVendor")">← Back To List</a>
}
@section HeadCss{
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/createUser/createUser.css")
    @BundleManager.IncludeStylesByEnv("~/www/reactpages/dist/css/function/function.css")
}
@section FooterJs{
    <script>
            var initialState = {
                siteName: @Html.Raw(serializer.Serialize(ViewBag.SiteName)),
                userID: @Html.Raw(serializer.Serialize(ViewBag.UserID)),
                userPWD: @Html.Raw(serializer.Serialize(ViewBag.UserPWD))
            }
    </script>

    @BundleManager.IncludeScriptsByEnv("~/www/reactpages/dist/js/createUser/createUser.js")
}

<div id="app-container"></div>