<configuration>
  <configSections>
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
    </configSections>
    <appSettings configSource="Web.AppSettings.config" />
    <connectionStrings configSource="Web.ConnectionString.config" />
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <trust level="Full" />
    <compilation debug="true" targetFramework="4.6.1" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Utility/Error">
      <error statusCode="403" redirect="~/Utility/Error?err=403" />
      <error statusCode="404" redirect="~/Utility/Error?err=404" />
    </customErrors>
    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40" cookieless="UseCookies" name=".NAPFORMSAUTH_NAPLICENSEE" loginUrl="~/UserLogin/Login" timeout="2880" defaultUrl="~/" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <machineKey validationKey="DA13C9789D77B2FB7D6C182D4093182D0F9F52D8B498AF9C1E59826A48A60CFCC1E02652EE0A3A996EF4E4439A00CC8EAE42388F0DB5A7795933BD830A31ADB9" decryptionKey="DEFD2134E4817E65377651AC8D14C65BC01AA1AD6CAFED57720D0C0AB670456A" validation="SHA1" decryption="AES" />
    <sessionState mode="StateServer" cookieless="false" />
    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web" />
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <!-- Glimpse: This can be commented in to add additional data to the Trace tab when using WebForms
        <trace writeToDiagnosticsTrace="true" enabled="true" pageOutput="false" /> -->


  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-UA-Compatible" />
        <remove name="ETag" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <clientCache cacheControlMaxAge="8.00:00:00" cacheControlMode="UseMaxAge" />
    </staticContent>

    <modules runAllManagedModulesForAllRequests="true">

    </modules>

    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
