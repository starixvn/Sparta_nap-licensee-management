<?xml version="1.0" encoding="utf-8" ?>
<Functions>
  <Function Name="Site.Nap.Licensee">
    <Setting Key="NAP_SpecialCustSetting_CurrencyList" SpName="NAP_SpecialCustSetting_CurrencyList" DbName="DBTXN.CustDB.bodbLicenseeNet">
      <Mapping DataField="exchangeid" ObjectProperty="Id" />
      <Mapping DataField="currency" ObjectProperty="Name" />
    </Setting>
    <Setting Key="NAP_SpecialCustSetting_LicenseeList" SpName="NAP_SpecialCustSetting_LicenseeList" DbName="DBLIC.bodb_Licensee.bodbLicenseeNet">
      <Mapping DataField="SiteID" ObjectProperty="Id" />
      <Mapping DataField="SiteName" ObjectProperty="Name" />
    </Setting>
    <Setting Key="NAP_SpecialCustSetting_List" SpName="NAP_SpecialCustSetting_List" DbName="DBTXN.CustDB.bodbLicenseeNet">
    </Setting>
    <Setting Key="NAP_SpecialCustSetting_Sel" SpName="NAP_SpecialCustSetting_Sel" DbName="DBTXN.CustDB.bodbLicenseeNet">
    </Setting>
    <Setting Key="NAP_SpecialCustSetting_Modify" SpName="NAP_SpecialCustSetting_Modify" DbName="DBTXN.CustDB.bodbLicenseeNet">
    </Setting>
    <Setting Key="NAP_SpecialCustSettingAgent_SelByCurrencyAndLicensee" SpName="NAP_SpecialCustSettingAgent_SelByCurrencyAndLicensee" DbName="DBLIC.bodb_Licensee.bodbLicenseeNet">
      <Mapping DataField="AgentID" ObjectProperty="Id" />
      <Mapping DataField="AgentName" ObjectProperty="Name" />
    </Setting>
    <Setting Key="NAP_SpecialCustSetting_LogSel" SpName="NAP_SpecialCustSetting_LogSel" DbName="DBLOG.bodb_CustomerLog.bodbLicenseeNet">
    </Setting>
    <Setting Key="NAP_SpecialCustSettingGameType_Sel" SpName="NAP_SpecialCustSettingGameType_Sel" DbName="DBTXN.CustDB.bodbLicenseeNet">
    </Setting>
  </Function>
  <Function Name="Site.Nap.Licensee.SettingConfiguration">

    <Setting Key="NAP_LM_LicenseeSuperList" SpName="NAP_LM_LicenseeSuperList " DbName="DBEXT.bodb02.bodbLicenseeNet">
      <Mapping DataField="custid" ObjectProperty="Id" />
      <Mapping DataField="username" ObjectProperty="Name" />
    </Setting>

    <Setting Key="NAP_LM_LicenseePositionTakingSel" SpName="NAP_LM_LicenseePositionTakingSel " DbName="DBEXT.bodb02.bodbLicenseeNet">
    </Setting>
    <Setting Key="NAP_LM_LicenseePositionTakingUpd" SpName="NAP_LM_LicenseePositionTakingUpd" DbName="DBTXN.CustDB.bodbLicenseeNet">
    </Setting>

    <Setting Key="NAP_LM_LicenseeCommissionSel" SpName="NAP_LM_LicenseeCommissionSel" DbName="DBEXT.bodb02.bodbLicenseeNet">
    </Setting>
    <Setting Key="NAP_LM_LicenseeCommissionUpd" SpName="NAP_LM_LicenseeCommissionUpd" DbName="DBTXN.CustDB.bodbLicenseeNet">
    </Setting>

    <!--Bet setting-->
    <Setting Key="NAP_LM_LicenseeBetSettingSel" SpName="NAP_LM_LicenseeBetSettingSel " DbName="DBEXT.bodb02.bodbLicenseeNet">
    </Setting>
    <Setting Key="NAP_LM_LicenseeBetSettingUpd" SpName="NAP_LM_LicenseeBetSettingUpd " DbName="DBTXN.CustDB.bodbLicenseeNet">
    </Setting>

  </Function>

  <Function Name="Site.Nap.Licensee.VendorInfoManagement">
    <Setting Key="Nap_LM_LicVendorInfo_Select" SpName="Nap_LM_LicVendorInfo_Select" DbName="DBCUST.SiteConfig.bodbLicenseeNet">
      <Mapping DataField="LRF_Url" ObjectProperty="LrfUrl" />
    </Setting>
  </Function>
</Functions>