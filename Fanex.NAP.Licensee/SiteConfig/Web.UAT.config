<configuration>
    <configSections>
        <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core.Client" />
		<section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    </configSections>
    <appSettings configSource="Web.AppSettings.config" />
    <connectionStrings configSource="Web.ConnectionString.config" />

   	  <NapSettings Environment="UAT" EnableDirectLogin="1" SiteId="22" UnauthorizeUrl="~/UserLogin/Common/AccessDenied/" EnableReCheckin="true" HubUrl="http://nap-home.starific.net/v1/User/Login" ServiceUrls="http://10.2.190.41:8788/">
		<Domain>
			<add Name="nap-lm.starific.net" Path="/" />
		</Domain>
	</NapSettings>
	<ONEbook.UM ServiceUris="http://10.2.190.41:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="1:00" UMTo="23:00" SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline"> 
		<AllowedIPs AllowAll="true">
		</AllowedIPs>
	</ONEbook.UM>
	    <system.web>
		<trust level="Full" />
        <compilation debug="false" targetFramework="4.6.1" />
        <customErrors mode="RemoteOnly" defaultRedirect="~/Utility/Error">
			<error statusCode="403" redirect="~/Utility/Error?err=403" />
			<error statusCode="404" redirect="~/Utility/Error?err=404" />
		</customErrors>
        <authentication mode="Forms">
            <forms loginUrl="~/UserLogin/Login" cookieless="UseCookies" timeout="2880" name=".NAPLMFORMSAUTH" defaultUrl="~/Home/Index" path="/" />
        </authentication>
        <authorization>
            <allow users="*" />
        </authorization>
	<sessionState mode="StateServer" cookieless="false" timeout="20"  stateConnectionString="tcpip=10.2.190.41:42424" />
    <machineKey validationKey="DA13C9789D77B2FB7D6C182D4093182D0F9F52D8B498AF9C1E59826A48A60CFCC1E02652EE0A3A996EF4E4439A00CC8EAE42388F0DB5A7795933BD830A31ADB9" decryptionKey="DEFD2134E4817E65377651AC8D14C65BC01AA1AD6CAFED57720D0C0AB670456A" validation="SHA1" decryption="AES" />
