<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
		<section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    </configSections>
    <appSettings configSource="Web.AppSettings.config" />
    <connectionStrings configSource="Web.ConnectionString.config" />

    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/App_Data/" enableWatching="0" />
        </providers>
    </Fanex.Data.DbSettingProvider>
     <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.73\private$\entlib" defaultCategory="NAP-LM-UAT" />
   	  <NapSettings Environment="UAT" EnableDirectLogin="1" SiteId="22" UnauthorizeUrl="~/UserLogin/Common/AccessDenied/" EnableReCheckin="false" HubUrl="http://nap-home.starific.net/v1/User/Login" ServiceUrls="http://10.2.23.6:7257/api" AccessKey="F7bddTyedTmuFFPvg4wBJNyP8Xfg89q2i+2xvE1h82E=">
		<Domain>
			<add Name="nap-lm.starific.net" Path="/" />
		</Domain>
	</NapSettings>
	<ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="1:00" UMTo="23:00" SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline"> 
		<AllowedIPs AllowAll="true">
		</AllowedIPs>
	</ONEbook.UM>
	    <system.web>
		<trust level="Full" />
        <compilation debug="false" targetFramework="4.6.1" />
        <customErrors mode="RemoteOnly">
            <error statusCode="403" redirect="~/Utility/Error?err=403" />
            <error statusCode="404" redirect="~/Utility/Error?err=404" />
            <error statusCode="400" redirect="~/Utility/Error?err=404" />
        </customErrors>
        <authentication mode="Forms">
            <forms loginUrl="~/UserLogin/Login" cookieless="UseCookies" timeout="2880" name=".NAPLMFORMSAUTH" defaultUrl="~/Home/Index" path="/" />
        </authentication>
        <authorization>
            <allow users="*" />
        </authorization>
	<sessionState mode="StateServer" cookieless="false" timeout="20"  stateConnectionString="tcpip=10.40.40.22:42424" />
    <machineKey validationKey="DA13C9789D77B2FB7D6C182D4093182D0F9F52D8B498AF9C1E59826A48A60CFCC1E02652EE0A3A996EF4E4439A00CC8EAE42388F0DB5A7795933BD830A31ADB9" decryptionKey="DEFD2134E4817E65377651AC8D14C65BC01AA1AD6CAFED57720D0C0AB670456A" validation="SHA1" decryption="AES" />
         <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web" />
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>

        
    </system.web>

    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <remove name="X-UA-Compatible" />
                <remove name="ETag" />
            </customHeaders>
        </httpProtocol>
        <staticContent>
            <clientCache cacheControlMaxAge="8.00:00:00" cacheControlMode="UseMaxAge" />
        </staticContent>
       <modules runAllManagedModulesForAllRequests="true">

    </modules>
	 <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    </system.webServer>

