<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{        
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.LOCAL
        },
		
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.UAT
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.PRO
        },
		new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.SIT
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.KLDR
        },
    };
#>
<#+
	enum SiteEnvironment
    {
        LOCAL,
        UAT,
        PRO,
		SIT,
        KLDR
    }

	class SiteInfo
    {
        //Web config value.
        public SiteEnvironment SiteEnvironment { get; set; }

		public string SessionState
        {
            get
			{
                switch (SiteEnvironment)
                {
                    case SiteEnvironment.LOCAL:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" stateConnectionString=\"tcpip=ha.nexdev.net:42424\" />";
                    case SiteEnvironment.UAT:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" timeout=\"20\"  stateConnectionString=\"tcpip=10.99.98.117:42424\" />";
				    case SiteEnvironment.SIT:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" timeout=\"20\"  stateConnectionString=\"tcpip=172.16.4.76:42424\" />";
				    case SiteEnvironment.PRO:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" timeout=\"20\"  stateConnectionString=\"tcpip=10.2.27.8:42424\" />";
                    case SiteEnvironment.KLDR:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" timeout=\"20\"  stateConnectionString=\"tcpip=10.143.8.200:42424\" />";
                    default:
                        return string.Empty;
                }
            }
        }
		
		
    }
#>