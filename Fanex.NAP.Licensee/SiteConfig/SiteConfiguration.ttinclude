<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{        
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.LOCAL
        },
		
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.UAT
        },
		  new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.BACKUPMNL
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.PRO
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.SANDBOX
        }
    };
#>
<#+
	enum SiteEnvironment
    {
        LOCAL,
        UAT,
		BACKUPMNL,
        PRO,
        SANDBOX
    }

	class SiteInfo
    {
        //Web config value.
        public SiteEnvironment SiteEnvironment { get; set; }

         public string LoggingServer
        {
            get
            {
                switch (SiteEnvironment)
                {
                    case SiteEnvironment.LOCAL:
                        return "<Fanex.Logging msmqPath=\"FormatName:DIRECT=tcp:10.18.200.209\\private$\\entlib\" defaultCategory=\"NAP-LM-LOCAL\" />";
                    case SiteEnvironment.UAT:
                        return "<Fanex.Logging msmqPath=\"FormatName:DIRECT=tcp:10.40.40.73\\private$\\entlib\" defaultCategory=\"NAP-LM-UAT\" />";
                    case SiteEnvironment.BACKUPMNL:
                        return "<Fanex.Logging msmqPath=\"FormatName:DIRECT=TCP:10.2.98.3\\private$\\entlib\" defaultCategory=\"Licensee-Live\" />";

					case SiteEnvironment.PRO:
                        return "<Fanex.Logging msmqPath=\"FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib\" defaultCategory=\"NAP-LM\" />";
                    case SiteEnvironment.SANDBOX:
                        return "<Fanex.Logging msmqPath=\"FormatName:DIRECT=tcp:10.18.200.209\\private$\\entlib\" defaultCategory=\"NAP-LM-LOCAL\" />";
                    default:
                        return string.Empty;
                }
            }
        }
		public string SessionState
        {
            get
			{
                switch (SiteEnvironment)
                {
                    case SiteEnvironment.LOCAL:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" />";
                    case SiteEnvironment.UAT:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" timeout=\"10\"  stateConnectionString=\"tcpip=10.40.40.135:42424\" />";
                    case SiteEnvironment.BACKUPMNL:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" timeout=\"10\"  stateConnectionString=\"tcpip=10.2.12.10:42424\" />";

				    case SiteEnvironment.PRO:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" timeout=\"10\"  stateConnectionString=\"tcpip=10.40.40.135:42424\" />";
                    case SiteEnvironment.SANDBOX:
                        return "<sessionState mode=\"StateServer\" cookieless=\"false\" />";
                    default:
                        return string.Empty;
                }
            }
        }
		
		
    }
#>