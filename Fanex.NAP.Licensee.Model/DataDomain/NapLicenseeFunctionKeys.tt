	<#
		SqlConnection conn = new SqlConnection(connectionString);

		string command = string.Format("SELECT DISTINCT FunctionKey from [NAP_Functions] INNER JOIN [NAP_Sites] on [NAP_Functions].SiteId=[NAP_Sites].SiteId WHERE SiteName='Licensee Management' AND [NAP_Functions].IsActive =1");

